generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  pending
  running
  completed
  failed
}

model Job {
  id        String    @id @default(uuid())
  title     String
  type      String
  status    JobStatus @default(pending)
  version   Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
